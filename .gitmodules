[submodule ".registry"]
	path = .registry
	url = https://github.com/r-universe-org/cran-to-git
	branch = HEAD
[submodule "depictr"]
	path = depictr
	url = https://github.com/pablobernabeu/depictr
[submodule "pilotr"]
	path = pilotr
	url = https://github.com/cran/pilotr
[submodule "scopusflow"]
	path = scopusflow
	url = https://github.com/pablobernabeu/scopusflow
[submodule "theoryforge"]
	path = theoryforge
	url = https://github.com/cran/theoryforge
